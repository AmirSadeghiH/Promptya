# Promptya Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env files to version control!

# =============================================================================
# REQUIRED IN PRODUCTION (DEBUG=false)
# =============================================================================

# Django secret key - generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Comma-separated list of allowed hosts (e.g., promptya.app,www.promptya.app)
DJANGO_ALLOWED_HOSTS=*

# Canonical site URL for SEO (canonical tags, sitemap, Open Graph)
# Must be HTTPS in production
PROMPTYA_SITE_URL=https://promptya.app

# Database URL (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Redis URL for caching and sessions
# Format: redis://:PASSWORD@HOST:PORT/DB
REDIS_URL=

# Email (SMTP) - required for password reset, notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Promptya <noreply@promptya.app>

# CSRF trusted origins (comma-separated, must include scheme)
# e.g., https://promptya.app,https://www.promptya.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# =============================================================================
# OPTIONAL: AI PROVIDER (can also be configured in Django admin)
# =============================================================================

# AI provider base URL (OpenAI-compatible)
# AI_PROVIDER_BASE_URL=https://api.gapgpt.app/v1

# AI provider API key
# AI_PROVIDER_API_KEY=

# AI provider model name
# AI_PROVIDER_MODEL=gapgpt/z-image

# =============================================================================
# OPTIONAL: S3-COMPATIBLE MEDIA STORAGE (AWS S3, Cloudflare R2, MinIO, etc.)
# =============================================================================

# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=  # For non-AWS S3 (e.g., https://<account>.r2.cloudflarestorage.com)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# =============================================================================
# DEVELOPMENT OVERRIDES
# =============================================================================

# Set to "true" to enable debug mode (NEVER in production!)
# DJANGO_DEBUG=true

# Override secure settings for local HTTPS testing
# DJANGO_SECURE_SSL_REDIRECT=false

# =============================================================================
# POSTGRES (for docker-compose)
# =============================================================================

# POSTGRES_DB=promptya
# POSTGRES_USER=promptya
# POSTGRES_PASSWORD=